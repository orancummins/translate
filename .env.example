# Copy to .env on your own machine (./run.sh). Never commit .env.
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
BRAND=tripadvisor
# KEY_MODE=server keeps keys here (default). A shared server runs KEY_MODE=visitor (serve.sh): each visitor pastes their own.
# KEY_MODE=server
# Optional voices (ElevenLabs voice ids): the manager, and your own lines when a call is replayed
# ELEVENLABS_VOICE_MANAGER=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_VOICE_USER=pNInz6obpgDQGcFmaJgB
